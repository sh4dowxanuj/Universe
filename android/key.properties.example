# Example key.properties for signing the release APK place key in android/app
# Copy this file to `android/key.properties` and fill in the real values.
# Do NOT commit your real `android/key.properties` or keystore to git.

storeFile=app/sh4dow.pfx
storePassword=YOUR_STORE_PASSWORD
keyAlias=sh4dow
keyPassword=YOUR_KEY_PASSWORD
